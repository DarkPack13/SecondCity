// the probability that artifacts spawn in crates
// note, this is multiplied by the random artifact's chance, so for example, 20% chance a crate drops an artifact, and 50% chance a random artifact
// actually spawns an artifact, gives a 10% chance a crate actually has an artifact.
#define ARTIFACT_CRATE_PROBABILITY 21

// the probability that the random artifact object actually spawns an artifact
#define ARTIFACT_RANDOM_PROBABILITY 55
